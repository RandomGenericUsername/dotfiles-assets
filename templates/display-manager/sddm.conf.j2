# SDDM config (rendered by the display_manager role).
#
# Enables the Pixie theme and a WAYLAND greeter. DisplayServer=wayland runs the
# greeter under a Wayland compositor (no X11/GPU grab), which is what avoids
# the hard-freeze that affected X11 greeters running Hyprland.
[General]
DisplayServer={{ display_manager_sddm_display_server }}
GreeterEnvironment=QT_QPA_PLATFORM=wayland

# The Wayland greeter still needs a compositor. SDDM's implicit default is
# `weston --shell=kiosk`; naming it here keeps the dependency visible in the
# rendered config, and the consumer can override the command for another
# compositor without this repository knowing its package list (spine AD-9).
[Wayland]
CompositorCommand={{ display_manager_sddm_compositor_command | default('weston --shell=kiosk') }}

[Theme]
Current=pixie
CursorTheme=Adwaita

# Disable greeter timeout (prevents auto-logout after ~2 minutes)
[Greeter]
SessionTimeout=0
