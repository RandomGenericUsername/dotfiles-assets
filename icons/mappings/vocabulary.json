{
  "$comment": "The declared color-role vocabulary for the icons corpus. This file is the vocabulary of record: an icons mapping value is either one of these role names or a Phase-A legacy baseline entry (see `phase_a_legacy_baseline`, which Phase B must empty). It is not a mapping file (the consumer never loads it) and it renders nothing.",
  "vocabulary": 1,
  "source": {
    "producer": "theme-producer (tpr)",
    "requirement": "REQ-022",
    "target_release": "v0.5.0",
    "engine_roles": 50,
    "produced_roles": 1,
    "role_count": 51,
    "note": "The 50 engine roles are matugen 4.2.0's Material 3 set; `on_backdrop` is tpr's one produced role (REQ-022: ink over the wallpaper's bar band, max WCAG contrast against the top 48 rows of the source image). At the time this file was written tpr HEAD is v0.4.0 and REQ-022 is not implemented yet, so `on_backdrop` is declared forward-looking: a consumer resolves it from colors.yaml only once tpr v0.5.0 ships. Nothing in this corpus renders from this file.",
    "aliases_are_not_roles": {
      "note": "tpr also resolves stable aliases to roles. Aliases are convenient for consumers but they hide the intent, and two of them name the wrong pole, so the icons corpus carries role names only.",
      "alias_to_role": {
        "background": "surface",
        "surface": "surface",
        "on_surface": "on_surface",
        "error": "error",
        "foreground": "on_surface",
        "accent": "primary",
        "accent-muted": "secondary",
        "warning": "tertiary"
      },
      "not_roles": [
        "foreground",
        "accent",
        "accent-muted",
        "warning"
      ]
    }
  },
  "surface_classes": {
    "enum": [
      "wallpaper",
      "dark-glass",
      "solid"
    ],
    "contract": {
      "wallpaper": "The glyph is composited directly over the wallpaper. Its ink MUST be `on_backdrop`; decorative accents may use primary/tertiary/error but the glyph must still read by shape when they do not.",
      "dark-glass": "The glyph sits on a translucent sheet (alpha(surface*, ~0.9) over a transparent window). Use the on-surface family (on_surface, on_surface_variant, on_primary, on_primary_container, ...) for the sheet it is actually on; `on_backdrop` is wrong here because there is no wallpaper band behind the glyph.",
      "solid": "The glyph sits on an opaque surface, field or self-painted container. Use the on-surface / on-container family for that surface; `on_backdrop` is wrong here for the same reason as dark-glass."
    }
  },
  "roles": [
    "background",
    "error",
    "error_container",
    "inverse_on_surface",
    "inverse_primary",
    "inverse_surface",
    "on_background",
