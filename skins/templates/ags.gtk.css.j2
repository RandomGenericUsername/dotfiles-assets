/* ── Wi-Fi popover — REQ-007 ────────────────────────────────────────────────
   The bar-anchored Wi-Fi popover is a layer-shell surface, so its chrome is
   `surface.panel` (never `surface.window`, never the unconsumed
   `surface.overlay` role). Rows are cells, the Run/Join/Scan actions and the
   password field are controls, and the footer/settings text is ink/type.
   Widths, spacing, section separators and the connected/warn semantic signal
   stay in `../ags-bar/style.css`: this template paints roles only. */

window.wifi-popup {
  color: {{SKIN_INK_INK}};
  font-family: {{SKIN_TYPE_FONT_FAMILY}};
}

.wifi-surface {
  background-color: {{SKIN_SURFACE_PANEL_BG}};
  border: {{SKIN_SURFACE_PANEL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PANEL_BORDER}};
  border-radius: {{SKIN_SURFACE_PANEL_RADIUS}};
  /* No skin padding here: the mock's popover chrome has no outer inset, and
     the header/sections/footer own their 16 px inset. A role padding token
     here added a second inset and shifted every row away from the mock. */
  box-shadow: {{SKIN_SURFACE_PANEL_SHADOW}};
  backdrop-filter: {{SKIN_SURFACE_PANEL_BLUR}};
}

.wifi-settings-surface {
  background-color: {{SKIN_SURFACE_PANEL_BG}};
  border: {{SKIN_SURFACE_PANEL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PANEL_BORDER}};
  border-radius: {{SKIN_SURFACE_PANEL_RADIUS}};
  padding: {{SKIN_SURFACE_PANEL_PADDING}};
  box-shadow: {{SKIN_SURFACE_PANEL_SHADOW}};
  backdrop-filter: {{SKIN_SURFACE_PANEL_BLUR}};
}

.wifi-head-title,
.wifi-hero-ssid,
.wifi-row-name,
.wifi-pw-title,
.wifi-off-title,
.wifi-empty-title,
.wifi-settings-head,
.wifi-foot-title,
.wifi-settings-name {
  color: {{SKIN_INK_INK}};
  font-size: {{SKIN_TYPE_SIZE_TITLE}};
}

.wifi-head-sub,
.wifi-hero-meta,
.wifi-detail-val,
.wifi-row-sub,
.wifi-pw-sub,
.wifi-off-copy,
.wifi-empty-copy,
.wifi-list-title,
.wifi-settings-label,
.wifi-settings-help,
.wifi-settings-sub,
.wifi-settings-foot,
.wifi-foot-sub,
.wifi-test-title {
  color: {{SKIN_INK_INK_DIM}};
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
}

.wifi-detail-key,
.wifi-list-count,
.wifi-list-empty,
.wifi-pw-kicker,
.wifi-pw-label,
.wifi-test-label,
.wifi-test-unit,
.wifi-test-foot,
.wifi-foot-hint,
.wifi-nearby-chevron {
  color: alpha({{SKIN_INK_INK}}, 0.4);
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
}

.wifi-row {
  background-color: {{SKIN_SURFACE_CELL_BG}};
  border-radius: {{SKIN_SURFACE_CELL_RADIUS}};
  color: {{SKIN_INK_INK}};
}

.wifi-row:hover {
  background-color: {{SKIN_SURFACE_CELL_HOVER_BG}};
}

.wifi-row-action {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  color: {{SKIN_INK_INK}};
  font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
  font-weight: {{SKIN_SURFACE_CONTROL_FONT_WEIGHT}};
}

.wifi-row-action:hover {
  border-color: {{SKIN_STATE_HOVER_RING}};
}

.wifi-gear:hover,
.wifi-gear.is-active,
.wifi-scan:hover,
.wifi-nearby-toggle:hover,
.wifi-notice-dismiss:hover,
.wifi-foot-row:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.wifi-scan {
  color: {{SKIN_INK_INK_DIM}};
  font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
  font-weight: {{SKIN_SURFACE_CONTROL_FONT_WEIGHT}};
}

.wifi-nearby-chevron {
