/*
 * skins/templates/ags.gtk.css.j2 — settings + Bluetooth paint rules.
 *
 * FIDELITY POLICY (Appearance token model v2)
 * -----------------------------
 * `glass` is a faithful extraction of today's ../ags-bar/style.css, not a
 * design-system re-expression of it. A SKIN_* placeholder is used ONLY
 * where a v2 token is a genuine global knob: surface.panel paint/frame/radius/
 * padding/shadow/blur, surface.card paint/radius/padding, surface.cell
 * paint/radius/padding, surface.control paint/border/radius/padding/type,
 * surface.pill paint/border/radius/padding/type, state.hover/selected/focus/
 * disabled, the type scale and ink. Everything else is a
 * component literal copied from style.css, expressed with palette roles only
 * (never a hex colour).
 *
 * BORDER OWNERSHIP (v2)
 * ---------------------
 * `surface.panel.border-width` is the outer panel/frame border: 1.5px on
 * .settings-surface (:163). `surface.card.border-width` is the card/tile
 * hairline (1px, :183/:559), `surface.control.border-width` is the row-action
 * hairline (1px, :442), and `surface.pill.border-width` is the badge hairline
 * (1px, :428/:433); the Wi-Fi settings top rule uses the control width (:761). The row/cell itself has NO border (border: none,
 * :378-387); a transparent border would change its allocated height
 * (measured 54px instead of 50px).
 *
 * LAYOUT IS TSX-OWNED. `panel-width` and `bt-list-spacing` remain in the
 * manifest and resolved tokens.json for `skinValue()`, but this template MUST
 * NOT expand them into CSS. (`bar-row-height`/`chip-min` were retired in
 * v0.12.2; no app reads them.) The widgets set the panel width
 * (SettingsPanel.tsx), list spacing (BluetoothContent.tsx) and row/chip
 * geometry; emitting min-width, margin or min-height here would be a second
 * owner and break parity when either side changes. The template uses the
 * source's literal component measurements instead (for example the 30px
 * signal glyph).
 *
 * `gap` is not consumed here: every gap-looking source declaration is a
 * component padding. The fixed `gap` rhythm is no longer a token in v2.
 *
 * The app owns this selector vocabulary and the widget structure. There are no
 * structure or variant tokens, no literal hex colours and no CSS transition
 * declarations (GTK 4.24 ignores transitions, so shipping one would be dead CSS).
 *
 * ink-over is {{SKIN_INK_INK_OVER}}: on a painted container the app resolves the
 * paired on-colour automatically instead of hard-coding a second ink token.
 *
 * RADIUS CLIPPING: a rounded container clips its children only when the app
 * sets overflow HIDDEN on the widget that carries the radius (GTK CSS has no
 * overflow property). The caller MUST set overflow HIDDEN on the widget with
 * .settings-surface and on any other radius-clipped surface whose children can
 * reach a corner; this template can state the radius but cannot apply the clip.
 */

window.settings-panel,
window.settings-catcher {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  color: {{SKIN_INK_INK}};
  font-family: {{SKIN_TYPE_FONT_FAMILY}};
}

/* The click-outside catcher needs a non-zero fill to be hit-testable on this
   compositor. One percent is imperceptible and is copied from style.css:157-159
   (the catcher fill is a surface wash, not the ink token). */
.settings-catcher-fill {
  background-color: alpha(@surface, 0.01);
}

/* style.css:161-166 — no box-shadow and no backdrop-filter in the source. */
.settings-surface {
  background-color: {{SKIN_SURFACE_PANEL_BG}};
  border: {{SKIN_SURFACE_PANEL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PANEL_BORDER}};
  border-radius: {{SKIN_SURFACE_PANEL_RADIUS}};
  padding: {{SKIN_SURFACE_PANEL_PADDING}};
  box-shadow: {{SKIN_SURFACE_PANEL_SHADOW}};
  backdrop-filter: {{SKIN_SURFACE_PANEL_BLUR}};
}

.settings-scroll,
.settings-scroll viewport {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border: none;
}

/* style.css:174-178 — the scrollbar is a fixed 5px detail, not a skin radius. */
.settings-scroll scrollbar slider {
  min-width: 5px;
  border-radius: 5px;
  background-color: alpha({{SKIN_INK_INK}}, 0.25);
}

/* Cards. .settings-password shares the card paint (style.css:556-561);
   .settings-tile and .settings-mini have their own padding (:194-199, :260-268).
   The card hairline is 1px in the source (`:183`, `:559`). */
.settings-card,
.settings-password {
  background-color: {{SKIN_SURFACE_CARD_BG}};
  border: {{SKIN_SURFACE_CARD_BORDER_WIDTH}} solid {{SKIN_SURFACE_CARD_BORDER}};
  border-radius: {{SKIN_SURFACE_CARD_RADIUS}};
  padding: {{SKIN_SURFACE_CARD_PADDING}} 11px;
}

.settings-card-title {
  font-size: {{SKIN_TYPE_SIZE_TITLE}};
  font-weight: 650;
}

/* style.css:194-199 — capability tile has asymmetric padding. */
.settings-tile {
  background-color: {{SKIN_SURFACE_CARD_BG}};
  border: {{SKIN_SURFACE_CARD_BORDER_WIDTH}} solid {{SKIN_SURFACE_CARD_BORDER}};
  border-radius: {{SKIN_SURFACE_CARD_RADIUS}};
  padding: 8px 11px 8px 10px;
}

.settings-tile-title {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  font-weight: 600;
}

.settings-tile-sub {
  font-size: {{SKIN_TYPE_SIZE_META}};
  color: {{SKIN_INK_INK_DIM}};
}

/* style.css:211-214 — the chevron is a 16px glyph at half ink. */
.settings-chevron {
  font-size: {{SKIN_TYPE_SIZE_DISPLAY}};
  color: alpha({{SKIN_INK_INK}}, 0.5);
}

/* style.css:260-268 — mini action tile keeps its 10px padding and its
   none-shadow. */
.settings-mini {
  min-height: 0;
  padding: {{SKIN_SURFACE_CARD_PADDING}};
  background-color: {{SKIN_SURFACE_CARD_BG}};
  background-image: none;
  border: {{SKIN_SURFACE_CARD_BORDER_WIDTH}} solid {{SKIN_SURFACE_CARD_BORDER}};
  border-radius: {{SKIN_SURFACE_CARD_RADIUS}};
  color: {{SKIN_INK_INK}};
  box-shadow: none;
}

.settings-mini:hover {
  border-color: {{SKIN_STATE_HOVER_RING}};
}

.settings-mini-title {
  font-size: 12px;
  font-weight: 600;
}

/* Wi-Fi / Bluetooth rows (style.css:378-387). The row is transparent and has no
   border; surface.cell.padding and surface.control.radius are genuine density knobs. Row height and
   list spacing are TSX-owned, so this rule emits neither. */
.settings-net {
  padding: {{SKIN_SURFACE_CELL_PADDING}} 9px;
  background-color: {{SKIN_SURFACE_CELL_BG}};
  background-image: none;
  border: none;
  border-radius: {{SKIN_SURFACE_CELL_RADIUS}};
  box-shadow: none;
  color: {{SKIN_INK_INK}};
}

.settings-net:hover {
  background-color: {{SKIN_SURFACE_CELL_HOVER_BG}};
}

.settings-net.sel {
  background-color: {{SKIN_STATE_SELECTED_FILL}};
  color: {{SKIN_STATE_SELECTED_INK}};
}

.settings-net.out-of-range {
  opacity: 0.45;
}

/* style.css:407-411 — the name is a 12.5px title; 48px keeps the cell from
   collapsing while the badge reserves its width. */
.settings-net-name {
  font-size: {{SKIN_TYPE_SIZE_TITLE}};
  font-weight: 600;
  min-width: 48px;
}

/* style.css:413-416 — line two is a small 10.5px literal, not text-size. */
.settings-net-sub {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: {{SKIN_INK_INK_DIM}};
}

.settings-net.sel .settings-net-sub {
  color: alpha(@on_primary_container, 0.85);
}

/* style.css:422-429 — badge type/padding are component details; only the pill
   radius is a skin knob. The badge hairline is 1px in the source. */
.settings-badge {
  font-size: {{SKIN_SURFACE_PILL_FONT_SIZE}};
  letter-spacing: {{SKIN_SURFACE_PILL_LETTER_SPACING}};
  padding: {{SKIN_SURFACE_PILL_PADDING}} 6px;
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  background-color: {{SKIN_SURFACE_PILL_BG}};
  border: {{SKIN_SURFACE_PILL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PILL_BORDER}};
}

.settings-badge.conn {
  background-color: {{SKIN_INK_ACCENT_MUTED}};
  border: {{SKIN_SURFACE_PILL_BORDER_WIDTH}} solid alpha({{SKIN_INK_ACCENT}}, 0.45);
  color: {{SKIN_INK_INK}};
}

/* Row actions: Connect, Pair, Unpair (style.css:437-448). The hairline is 1px in
   the source; padding/font/geometry are component details, and width/height are
   TSX-owned. */
.settings-rowact {
  padding: {{SKIN_SURFACE_CONTROL_PADDING}} 8px;
  font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
  font-weight: {{SKIN_SURFACE_CONTROL_FONT_WEIGHT}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  background-image: none;
  box-shadow: none;
  color: {{SKIN_INK_INK}};
}

.settings-rowact:hover {
  border-color: {{SKIN_STATE_HOVER_RING}};
}

.settings-rowact.disabled {
  opacity: 0.5;
}

.settings-rowact.subtle {
  opacity: 0.68;
}

.settings-rowact.subtle:hover {
  opacity: 1;
  border-color: alpha({{SKIN_INK_INK}}, 0.4);
}

.settings-rowact.danger {
  border-color: @tertiary;
  color: @tertiary;
}

.settings-rowact.danger:hover {
  border-color: @secondary;
  color: @secondary;
}

/* style.css:488-490 — a confirming row is a mode, not a connection state. */
.settings-net.confirming {
  background: alpha({{SKIN_INK_INK}}, 0.06);
}

/* style.css:493-497 — the spinner is a fixed 14px glyph. */
.settings-spinner {
  min-width: 14px;
  min-height: 14px;
  color: {{SKIN_INK_ACCENT}};
}

.settings-divider {
  min-height: 1px;
  background-color: alpha({{SKIN_INK_INK}}, 0.06);
  margin: 4px 0;
}

/* Connected-device detail table (style.css:699-709). */
.settings-conn-details {
  padding: 6px 16px;
}

.settings-detail-row {
  min-height: 18px;
}

.settings-detail {
  font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
  color: alpha({{SKIN_INK_INK}}, 0.5);
}

/* Empty and inline message states (style.css:637-641). */
.settings-empty {
  padding: 18px 10px;
  font-size: 12px;
  color: alpha({{SKIN_INK_INK}}, 0.6);
}

.settings-other-networks {
  padding: 4px 0;
}

/* Level slider (style.css:350-371): a fixed 99px pill, not a skin radius. */
.settings-level-slider trough {
  min-height: 10px;
  min-width: 10px;
  border-radius: 99px;
  background-color: alpha({{SKIN_INK_INK}}, 0.16);
  border: none;
}

.settings-level-slider trough highlight {
  border-radius: 99px;
  background-color: {{SKIN_INK_ACCENT}};
}

.settings-level-slider trough slider {
  min-width: 15px;
  min-height: 15px;
  margin: -3px 0;
  border: none;
  border-radius: 50%;
  background-color: {{SKIN_INK_INK}};
  box-shadow: none;
}

/* Wi-Fi settings footer row (style.css:759-794). The top rule is the 1px
   hairline. The note/arrow are fixed small literals. */
.settings-wifi-settings-row {
  padding: 10px 16px;
  border-top: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid alpha({{SKIN_INK_INK}}, 0.06);
}

.settings-wifi-settings-row:hover {
  background-color: alpha({{SKIN_INK_INK}}, 0.05);
}

.settings-wifi-settings-label {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: alpha({{SKIN_INK_INK}}, 0.7);
}

.settings-wifi-settings-note {
  font-size: 10px;
  color: alpha({{SKIN_INK_INK}}, 0.3);
}

.settings-wifi-settings-arrow {
  font-size: 14px;
  color: alpha({{SKIN_INK_INK}}, 0.3);
}

/* Subview header: back button, title and the header row itself
   (style.css:287-325). The 26px/18px/13.5px measurements are component details. */
.settings-nav-header {
  min-height: 26px;
  padding-bottom: 7px;
}

.settings-back {
  min-width: 26px;
  min-height: 26px;
  padding: 0;
  border-radius: 8px;
  background-color: alpha({{SKIN_INK_INK}}, 0.12);
  background-image: none;
  border: none;
  box-shadow: none;
  color: {{SKIN_INK_INK}};
}

.settings-back:hover {
  background-color: alpha({{SKIN_INK_INK}}, 0.2);
}

.settings-back-glyph {
  font-size: 18px;
}

.settings-nav-title {
  font-size: 13.5px;
  font-weight: 650;
}

.settings-net-signal {
  min-width: 30px;
  min-height: 30px;
}

.settings-section-label {
  font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
  font-weight: {{SKIN_SURFACE_CONTROL_FONT_WEIGHT}};
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: alpha({{SKIN_INK_INK}}, 0.4);
  padding: {{SKIN_SURFACE_CONTROL_PADDING}} 16px;
}

.settings-chevron-row {
  padding: 8px 16px;
}

.settings-chevron-row:hover {
  background-color: alpha({{SKIN_INK_INK}}, 0.05);
}

.settings-chevron-label {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: alpha({{SKIN_INK_INK}}, 0.7);
}

/* ── Sound — REQ-005, the bar's one overlay surface family ──────────────────
   The AGS bar's sound popover, tray dropdown, settings popover, menus and the
   now-playing strip are app-owned LAYER-SHELL surfaces: doc 113 W-10 maps them
   to `surface.panel`, never `surface.window`. This template is the ONLY paint
   authority: the app's `audio-panel.css` carries dimensions, spacing, layout,
   content art and the semantic live green only.

   Roles:
     panel   the popover, tray dropdown, menus and settings popover
     card    the per-player Playing page
     cell    Mixer/tray/menu/settings rows
     control device/route/icon/transport/level controls
     pill    muted/live badges, the mode tab, the switch
     state   hover / selected / focus / disabled
     ink/type  text

   Widths (352 popover, 300 dropdown, 280 settings) are app layout, so the
   skin padding is inside those boxes (border-box) and never changes them. */

window.audio-popup,
window.tray-popup {
  color: {{SKIN_INK_INK}};
  font-family: {{SKIN_TYPE_FONT_FAMILY}};
}

.audio-surface,
.tray-surface,
.audio-settings {
  background-color: {{SKIN_SURFACE_PANEL_BG}};
  border: {{SKIN_SURFACE_PANEL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PANEL_BORDER}};
  border-radius: {{SKIN_SURFACE_PANEL_RADIUS}};
  padding: {{SKIN_SURFACE_PANEL_PADDING}};
  box-shadow: {{SKIN_SURFACE_PANEL_SHADOW}};
  backdrop-filter: {{SKIN_SURFACE_PANEL_BLUR}};
}

.audio-menu > contents {
  background-color: {{SKIN_SURFACE_PANEL_BG}};
  border: {{SKIN_SURFACE_PANEL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PANEL_BORDER}};
  border-radius: {{SKIN_SURFACE_PANEL_RADIUS}};
  padding: {{SKIN_SURFACE_PANEL_PADDING}};
  box-shadow: {{SKIN_SURFACE_PANEL_SHADOW}};
  backdrop-filter: {{SKIN_SURFACE_PANEL_BLUR}};
}

/* Output and Input are the same section label: one type face, size, weight,
   ink, casing and start alignment. */
.audio-section-label {
  font-size: {{SKIN_TYPE_SIZE_TITLE}};
  color: {{SKIN_INK_INK}};
}

.audio-muted-pill {
  font-size: {{SKIN_SURFACE_PILL_FONT_SIZE}};
  letter-spacing: {{SKIN_SURFACE_PILL_LETTER_SPACING}};
  padding: {{SKIN_SURFACE_PILL_PADDING}} 8px;
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  background-color: {{SKIN_INK_ACCENT_MUTED}};
  color: {{SKIN_INK_INK}};
}

.audio-big-number {
  color: {{SKIN_INK_INK}};
}

.audio-big-unit {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: {{SKIN_INK_INK_DIM}};
}

.audio-device-note,
.audio-page-index,
.audio-mixer-sub,
.audio-mixer-mixed,
.audio-section-summary,
.audio-settings-help {
  color: alpha({{SKIN_INK_INK}}, 0.4);
}

.audio-device {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  padding: {{SKIN_SURFACE_CONTROL_PADDING}} 10px;
  font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
  font-weight: {{SKIN_SURFACE_CONTROL_FONT_WEIGHT}};
  color: {{SKIN_INK_INK}};
}

.audio-device:hover,
.audio-device:focus {
  border-color: {{SKIN_STATE_HOVER_RING}};
}

.audio-device:disabled {
  color: {{SKIN_STATE_DISABLED_INK}};
}

.audio-device-name {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: {{SKIN_INK_INK}};
}

.audio-device-chevron {
  color: alpha({{SKIN_INK_INK}}, 0.4);
}

.audio-icon-button {
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  color: {{SKIN_INK_INK_DIM}};
}

/* Icon-only actions are BARE: no surface.control fill/border around the gear,
   mute, transport, carousel arrows, the read-only level or the Mixer mute.
   Only their hover/active state paints. Real controls (device/route fields,
   sliders, the switch) keep their role paint. */
.audio-icon-button,
.audio-transport-button,
.audio-carousel-button,
.audio-playing-level,
.audio-mixer-mute,
.audio-settings-gear {
  background-color: transparent;
  background-image: none;
  border: 1px solid transparent;
  box-shadow: none;
}

.audio-icon-button:hover,
.audio-icon-button:active {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.audio-icon-button.active,
.audio-icon-button:checked {
  color: {{SKIN_INK_ACCENT}};
  background-color: {{SKIN_INK_ACCENT_MUTED}};
}

.audio-icon-button:disabled {
  color: {{SKIN_STATE_DISABLED_INK}};
}

.audio-big-number {
  font-size: 28px;
  font-weight: 650;
  letter-spacing: -0.02em;
}

.audio-mode-tab {
  color: {{SKIN_INK_INK_DIM}};
}

.audio-mode-tab:hover {
  color: {{SKIN_INK_INK}};
}

.audio-mode-tab.selected {
  color: {{SKIN_INK_INK}};
  border-bottom-color: {{SKIN_INK_ACCENT}};
}

.audio-mode-label {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  font-weight: 650;
}

.audio-mode-dot {
  background-color: {{SKIN_INK_ACCENT}};
}

.audio-carousel-button {
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  color: alpha({{SKIN_INK_INK}}, 0.4);
}

.audio-carousel-button:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.audio-carousel-glyph {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
}

.audio-playing-page {
  background-color: {{SKIN_SURFACE_CARD_BG}};
  border: {{SKIN_SURFACE_CARD_BORDER_WIDTH}} solid {{SKIN_SURFACE_CARD_BORDER}};
  border-radius: {{SKIN_SURFACE_CARD_RADIUS}};
  padding: {{SKIN_SURFACE_CARD_PADDING}};
}

/* Artwork tiles are app-owned layout/content. The skin supplies only the
   fallback ink/type below; it must not paint a container, image frame or
   border behind the thumbnail/app icon. */

.audio-track-art-fallback {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: {{SKIN_INK_INK}};
}

.audio-app-tile-fallback {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: {{SKIN_INK_INK}};
}

.audio-app-name {
  font-size: {{SKIN_TYPE_SIZE_TITLE}};
  color: {{SKIN_INK_INK}};
}

/* Text-only player identity (raw MPRIS Identity/DesktopEntry); no artwork paint. */
.audio-player-identity,
.audio-tray-player-identity {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: {{SKIN_INK_INK_DIM}};
}

.audio-live-badge {
  font-size: {{SKIN_SURFACE_PILL_FONT_SIZE}};
  letter-spacing: {{SKIN_SURFACE_PILL_LETTER_SPACING}};
  padding: {{SKIN_SURFACE_PILL_PADDING}} 7px;
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  background-color: {{SKIN_SURFACE_PILL_BG}};
  border: {{SKIN_SURFACE_PILL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PILL_BORDER}};
  color: {{SKIN_INK_INK}};
}

.audio-track-title {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: {{SKIN_INK_INK}};
}

.audio-track-artist {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: {{SKIN_INK_INK_DIM}};
}

.audio-transport-button {
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  color: {{SKIN_INK_INK_DIM}};
}

.audio-transport-button.play {
  color: {{SKIN_INK_INK}};
}

.audio-glyph-button.active .audio-glyph {
  color: {{SKIN_INK_ACCENT}};
}

.audio-playing-level {
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  padding: {{SKIN_SURFACE_CONTROL_PADDING}} 6px;
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: alpha({{SKIN_INK_INK}}, 0.4);
}

.audio-playing-level:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.audio-time,
.audio-percent,
.audio-input-value,
.audio-mixer-pct {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: {{SKIN_INK_INK_DIM}};
}

.audio-empty-title {
  font-size: {{SKIN_TYPE_SIZE_TITLE}};
  color: {{SKIN_INK_INK_DIM}};
}

.audio-empty-sub,
.audio-empty-line,
.audio-consumer-use {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: alpha({{SKIN_INK_INK}}, 0.4);
}

.audio-empty-art {
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  background-color: alpha({{SKIN_INK_INK}}, 0.08);
}

.audio-mixer-row {
  background-color: {{SKIN_SURFACE_CELL_BG}};
  border-radius: {{SKIN_SURFACE_CELL_RADIUS}};
  padding: {{SKIN_SURFACE_CELL_PADDING}} 8px;
}

.audio-mixer-row:hover {
  background-color: {{SKIN_SURFACE_CELL_HOVER_BG}};
}

.audio-mixer-row + .audio-mixer-row {
  border-top: 1px solid alpha({{SKIN_INK_INK}}, 0.07);
}

.audio-mixer-mute {
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  color: {{SKIN_INK_INK_DIM}};
}

.audio-mixer-mute:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.audio-mixer-mute.active {
  color: {{SKIN_INK_ACCENT}};
  background-color: {{SKIN_INK_ACCENT_MUTED}};
}

.audio-route {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  padding: {{SKIN_SURFACE_CONTROL_PADDING}} 6px;
  font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
  font-weight: {{SKIN_SURFACE_CONTROL_FONT_WEIGHT}};
  color: {{SKIN_INK_INK_DIM}};
}

.audio-route:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.audio-route-label {
  font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
}

.audio-section {
  border-bottom: 1px solid alpha({{SKIN_INK_INK}}, 0.07);
}

.audio-section-head {
  color: {{SKIN_INK_INK}};
}

.audio-section-head:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
}

.audio-section-chevron {
  color: alpha({{SKIN_INK_INK}}, 0.4);
}

.audio-consumer {
  background-color: {{SKIN_SURFACE_CELL_BG}};
  border-radius: {{SKIN_SURFACE_CELL_RADIUS}};
  padding: {{SKIN_SURFACE_CELL_PADDING}} 9px;
}

.audio-consumer-name {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: {{SKIN_INK_INK}};
}

.audio-menu-heading {
  color: alpha({{SKIN_INK_INK}}, 0.4);
}

.audio-menu-option {
  border-radius: {{SKIN_SURFACE_CELL_RADIUS}};
  padding: {{SKIN_SURFACE_CELL_PADDING}} 8px;
  color: {{SKIN_INK_INK}};
}

.audio-menu-option:hover,
.audio-menu-option:focus {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.audio-menu-option.selected {
  background-color: {{SKIN_STATE_SELECTED_FILL}};
  color: {{SKIN_STATE_SELECTED_INK}};
}

.audio-menu-option:disabled {
  color: {{SKIN_STATE_DISABLED_INK}};
}

.audio-menu-note {
  color: alpha({{SKIN_INK_INK}}, 0.4);
}

.audio-option-mark {
  color: {{SKIN_INK_ACCENT}};
}

.audio-settings-head {
  font-size: {{SKIN_TYPE_SIZE_TITLE}};
  color: {{SKIN_INK_INK}};
}

.audio-settings-row {
  border-top: 1px solid alpha({{SKIN_INK_INK}}, 0.07);
  border-radius: {{SKIN_SURFACE_CELL_RADIUS}};
  padding: {{SKIN_SURFACE_CELL_PADDING}} 0;
}

.audio-settings-name {
  font-size: {{SKIN_TYPE_SIZE_META}};
  color: {{SKIN_INK_INK}};
}

.audio-switch {
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  background-color: {{SKIN_SURFACE_PILL_BG}};
  border: {{SKIN_SURFACE_PILL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PILL_BORDER}};
}

.audio-switch:checked {
  background-color: {{SKIN_INK_ACCENT}};
  border-color: transparent;
}

.audio-switch > slider {
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  background-color: {{SKIN_INK_INK}};
}

.audio-tray-caption {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: alpha({{SKIN_INK_INK}}, 0.4);
}

.audio-tray-source-name,
.audio-tray-artist {
  color: {{SKIN_INK_INK_DIM}};
}

.audio-tray-source-name {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
}

.audio-tray-title {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: {{SKIN_INK_INK}};
}

.audio-tray-artist {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
}

.audio-tray-divider,
.audio-tray-foot {
  border-top: 1px solid alpha({{SKIN_INK_INK}}, 0.07);
}

.audio-tray-players-head {
  color: alpha({{SKIN_INK_INK}}, 0.4);
}

.audio-tray-player {
  border-radius: {{SKIN_SURFACE_CELL_RADIUS}};
  padding: {{SKIN_SURFACE_CELL_PADDING}} 4px;
  color: {{SKIN_INK_INK}};
}

.audio-tray-player:hover {
  background-color: {{SKIN_SURFACE_CELL_HOVER_BG}};
}

.audio-tray-player.active {
  background-color: {{SKIN_STATE_SELECTED_FILL}};
  color: {{SKIN_STATE_SELECTED_INK}};
}

.audio-tray-player-name {
  font-size: {{SKIN_TYPE_SIZE_META}};
  color: {{SKIN_INK_INK}};
}

.audio-tray-player-track {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: alpha({{SKIN_INK_INK}}, 0.4);
}

.audio-tray-check {
  color: {{SKIN_INK_ACCENT}};
}

.audio-tray-open {
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  color: {{SKIN_INK_INK_DIM}};
}

.audio-tray-open:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.audio-tray-open-label {
  font-size: {{SKIN_TYPE_SIZE_META}};
}

/* Bar strip (inside window#bar). The bar owns the transparent window; the
   strip is a cell/control family like the rest of the row. */
.audio-strip-main {
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
}

.audio-strip-main:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
}

.audio-strip-title {
  font-size: {{SKIN_TYPE_SIZE_META}};
  color: {{SKIN_INK_INK}};
}

.audio-strip-artist {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: {{SKIN_INK_INK_DIM}};
}

.audio-strip-controls .audio-glyph-button.active .audio-glyph {
  color: {{SKIN_INK_ACCENT}};
}

.audio-icon-button:focus-visible,
.audio-device:focus-visible,
.audio-route:focus-visible,
.audio-carousel-button:focus-visible,
.audio-mode-tab:focus-visible,
.audio-section-head:focus-visible,
.audio-playing-level:focus-visible,
.audio-menu-option:focus-visible,
.audio-tray-player:focus-visible,
.audio-tray-open:focus-visible,
.audio-hero-slider:focus-visible,
.audio-level-slider:focus-visible,
.audio-seek-slider:focus-visible {
  outline: 2px solid {{SKIN_STATE_FOCUS_RING}};
  outline-offset: 2px;
}
