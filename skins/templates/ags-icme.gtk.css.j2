/*
 * skins/templates/ags-icme.gtk.css.j2 — icon color mapping editor paint.
 *
 * Extracted from ../ags-icme/style.css. The editor is a full-window tool, so
 * the window carries bg-panel; its inset wells/cards take bg-card/radius-card
 * and hairline-w, while tree rows, fields, toggles and buttons take
 * radius-cell. Ink, ink-dim, accent and title/text sizes are skin knobs.
 * Region widths, pane margins, small type, monospace faces and the selection
 * rings/tints stay source literals expressed as palette roles.
 *
 * The source's black inset shading has no hex here: the wells use the darkest
 * surface-container role at the same alpha, so the no-hex rule holds without
 * inventing a token.
 */
window#icon-color-mapping-editor-window {
  background-color: {{SKIN_BG_PANEL}};
  color: {{SKIN_INK}};
  font-family: {{SKIN_FONT_FAMILY}};
}

.icme-root {
  min-width: 960px;
  min-height: 600px;
}

.icme-left {
  min-width: 240px;
  background-color: alpha(@surface_container, 0.28);
  border-right: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
}

.icme-center {
  background-color: transparent;
}

.icme-right {
  min-width: 320px;
  background-color: alpha(@surface_container, 0.28);
  border-left: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
}

.icme-pane-title {
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: alpha({{SKIN_INK}}, 0.42);
  margin: 12px 14px 6px;
}

.icme-status {
  color: @tertiary;
  margin: 0 14px;
}

.canvas-bar {
  background-color: alpha(@surface_container, 0.16);
  border-bottom: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  padding: 8px 14px;
}

.template-path {
  font-family: monospace;
  font-size: 11px;
  color: {{SKIN_INK_DIM}};
}

.toggle {
  background-color: transparent;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  color: alpha({{SKIN_INK}}, 0.62);
  border-radius: {{SKIN_RADIUS_CELL}};
  padding: 4px 9px;
  font-size: 12px;
}

.toggle:hover {
  border-color: alpha({{SKIN_INK}}, 0.22);
  color: {{SKIN_INK}};
}

.toggle.on {
  border-color: {{SKIN_ACCENT}};
  color: {{SKIN_INK}};
  background-color: alpha({{SKIN_ACCENT}}, 0.18);
}

.canvas {
  padding: 16px;
  background-color: transparent;
}

.vcard {
  background-color: {{SKIN_BG_CARD}};
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  border-radius: {{SKIN_RADIUS_CARD}};
  padding: 8px;
  min-width: 150px;
}

.vcard:hover {
  border-color: alpha({{SKIN_INK}}, 0.22);
}

.vcard.main {
  border: 2px solid @primary;
  background-color: alpha(@primary, 0.12);
}

.vname {
  font-family: monospace;
  font-size: 11px;
  color: {{SKIN_INK_DIM}};
  margin-bottom: 6px;
}

.badge {
  font-size: 10px;
  color: @tertiary;
}

.diff {
  border-top: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  background-color: alpha(@surface_container_lowest, 0.18);
  padding: 10px 14px;
  font-family: monospace;
  font-size: 12px;
  min-height: 60px;
}

.diff-empty {
  color: {{SKIN_INK_DIM}};
}

.inputs {
  padding: 0 14px 10px;
}

.input-label {
  font-size: 11px;
  color: {{SKIN_INK_DIM}};
  margin: 9px 0 2px;
}

.path {
  background-color: @surface_container;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  border-radius: {{SKIN_RADIUS_CELL}};
  padding: 5px 7px;
  font-family: monospace;
  font-size: 11px;
}

.path.rw {
  border-color: @tertiary;
}

.pick {
  color: {{SKIN_INK_DIM}};
}

.tree {
  padding: 0 6px 14px;
}

.tree .group {
  color: alpha({{SKIN_INK}}, 0.42);
  font-size: 11px;
  padding: 6px 8px 2px;
}

.tree .item {
  border-radius: {{SKIN_RADIUS_CELL}};
  font-family: monospace;
  font-size: 12px;
  padding: 5px 8px 5px 20px;
}

.tree .item:hover {
  background-color: alpha({{SKIN_INK}}, 0.08);
}

.tree .item.active {
  background-color: @primary;
  color: @on_primary;
}

.tree .item.active .badge {
  background-color: alpha(@on_primary, 0.18);
  color: @on_primary;
}

.sel-panel {
  padding: 0 14px 10px;
}

.kv-key {
  color: {{SKIN_INK_DIM}};
}

.kv-value {
  font-family: monospace;
}

.shape-item {
  border: {{SKIN_HAIRLINE_W}} solid transparent;
  border-radius: {{SKIN_RADIUS_CELL}};
}

.shape-item.active {
  border: 2px solid @primary;
  background-color: alpha(@primary, 0.12);
}

.picker-title {
  font-size: {{SKIN_TITLE_SIZE}};
  color: {{SKIN_INK}};
  margin: 4px 14px 2px;
}

.picker-subtitle {
  font-size: 10px;
  letter-spacing: 0.04em;
  color: {{SKIN_INK_DIM}};
  margin: 0 14px 8px;
}

.token-grid {
  margin: 0 14px 10px;
}

.cell {
  min-width: 40px;
  min-height: 40px;
  border-radius: {{SKIN_RADIUS_CELL}};
  border: 2px solid transparent;
  background-color: transparent;
  padding: 2px;
}

.cell .fill {
  border-radius: 3px;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
}

.cell.current {
  border-color: {{SKIN_ACCENT}};
}

.cell.missing {
  opacity: 0.45;
}

.named-row {
  border: {{SKIN_HAIRLINE_W}} solid transparent;
  border-radius: {{SKIN_RADIUS_CELL}};
  margin: 0 14px 4px;
  padding: {{SKIN_CELL_PAD}};
}

.named-row.current {
  border: 2px solid @primary;
  background-color: alpha(@primary, 0.12);
}

.chip {
  border-radius: {{SKIN_RADIUS_CELL}};
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
}

.chip.missing {
  background-color: @surface_container_high;
}

.ph {
  font-family: monospace;
  font-size: {{SKIN_TEXT_SIZE}};
}

.tok {
  color: {{SKIN_INK_DIM}};
  font-size: 11px;
  font-family: monospace;
}

.tag {
  font-size: 10px;
  color: @tertiary;
}

.scope-block {
  padding-bottom: 6px;
}

.scope-hint {
  font-size: 11px;
  color: @tertiary;
  margin: 6px 14px 0;
}

.scope-warn {
  font-size: 11px;
  color: @error;
  margin: 4px 14px 0;
}

.input-warn {
  font-size: 11px;
  color: @tertiary;
  margin: 6px 14px 0;
}

.diff-text {
  font-family: monospace;
  font-size: 11px;
  color: {{SKIN_INK}};
}

.footer {
  padding: 10px 14px;
  border-top: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
}

.btn {
  padding: 7px;
  border-radius: {{SKIN_RADIUS_CELL}};
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  background-color: transparent;
  color: alpha({{SKIN_INK}}, 0.62);
  font-size: {{SKIN_TEXT_SIZE}};
}

.btn:hover {
  border-color: alpha({{SKIN_INK}}, 0.22);
  color: {{SKIN_INK}};
}

.btn.primary {
  background-color: @primary;
  border-color: transparent;
  color: @on_primary;
}

.save-error {
  font-size: 11px;
  color: @error;
  margin: 0 14px 6px;
}

.mode {
  font-size: 10px;
  padding: 2px 8px;
  border-radius: {{SKIN_RADIUS_CELL}};
}

.mode.templated {
  background-color: alpha({{SKIN_ACCENT}}, 0.22);
  color: {{SKIN_ACCENT}};
}

.mode.bare {
  background-color: alpha(@tertiary, 0.22);
  color: @tertiary;
}

.progress {
  margin: 10px 14px 4px;
  font-size: 11px;
  color: {{SKIN_INK_DIM}};
}

.progress-text {
  font-size: 11px;
  color: {{SKIN_INK_DIM}};
}

.progress-bar {
  min-height: 5px;
  margin-top: 4px;
}

.phlist {
  margin-bottom: 4px;
}

.phrow {
  border: {{SKIN_HAIRLINE_W}} solid transparent;
  border-radius: {{SKIN_RADIUS_CELL}};
  padding: {{SKIN_CELL_PAD}};
}

.phrow.picked {
  border: 2px solid @primary;
  background-color: alpha(@primary, 0.12);
}

.phrow .name {
  font-family: monospace;
  font-size: 11.5px;
}

.phrow .tok {
  font-size: 10px;
}

.phrow .use {
  font-size: 10px;
  color: {{SKIN_INK_DIM}};
}

.phrow .cur {
  font-size: 9.5px;
  color: @tertiary;
}

.phrow .cur.new {
  color: {{SKIN_ACCENT}};
}

.newph {
  border-top: {{SKIN_HAIRLINE_W}} dashed alpha({{SKIN_INK}}, 0.12);
  padding-top: 10px;
  margin-top: 10px;
}

.newph-input {
  background-color: @surface_container;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  border-radius: {{SKIN_RADIUS_CELL}};
  padding: 6px 8px;
  font-family: monospace;
  font-size: {{SKIN_TEXT_SIZE}};
}

.err {
  color: @error;
  font-size: 10.5px;
  min-height: 15px;
  padding: 2px 0;
}

.toklabel {
  font-size: 10.5px;
  color: {{SKIN_INK_DIM}};
  margin: 6px 0 4px;
}

.mini {
  margin: 0 0 6px;
}

.mini .cell {
  min-width: 24px;
  min-height: 24px;
  border-radius: {{SKIN_RADIUS_CELL}};
  border: 2px solid transparent;
}

.mini .cell.picked {
  border-color: {{SKIN_ACCENT}};
}

.mini-fill {
  min-height: 24px;
}

.assignbar {
  margin-top: 12px;
}

.hint {
  padding: 6px 14px 12px;
  font-size: 11px;
  color: {{SKIN_INK_DIM}};
}

.inspector-nav {
  background-color: alpha(@surface_container, 0.16);
  border-radius: {{SKIN_RADIUS_CELL}};
  padding: 3px;
  margin: 0 14px 10px;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
}

.inspector-tab-btn {
  padding: 6px 8px;
  font-size: 11.5px;
  font-weight: 500;
  border-radius: {{SKIN_RADIUS_CELL}};
  color: alpha({{SKIN_INK}}, 0.62);
  background-color: transparent;
  border: none;
}

.inspector-tab-btn.active {
  background-color: @primary;
  color: @on_primary;
}

.quick-reassign-btn {
  background-color: transparent;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  color: {{SKIN_ACCENT}};
  padding: 2px 7px;
  border-radius: {{SKIN_RADIUS_CELL}};
  font-size: 10px;
  margin-left: 8px;
}

.badge-dot {
  min-width: 6px;
  min-height: 6px;
  border-radius: {{SKIN_RADIUS_PILL}};
  background-color: @tertiary;
  margin-left: 4px;
}

.bare-notice {
  background-color: alpha(@tertiary, 0.12);
  border: {{SKIN_HAIRLINE_W}} solid alpha(@tertiary, 0.30);
  color: @tertiary;
  padding: 8px 10px;
  border-radius: {{SKIN_RADIUS_CELL}};
  font-size: 11px;
  margin: 0 14px 10px;
}

.picker {
  margin-bottom: 4px;
}

.diff-pane {
  background-color: transparent;
}
