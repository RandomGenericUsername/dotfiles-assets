/*
 * skins/templates/ags-capture.gtk.css.j2 — capture bar, overlay, panel and
 * recording cluster paint.
 *
 * Extracted from ../ags-capture-tool/style.css. The bar/panel/view are global
 * panels (bg-panel, border-w, border, radius-panel, shadow, blur); cards and
 * popovers take bg-card/radius-card/hairline-w; fields, buttons and segmented
 * controls take radius-cell; full-round handles/toggles take radius-pill.
 * Ink, ink-dim, accent and title/text sizes are skin knobs. Every component
 * literal is copied from the source: overlay geometry, field padding, small
 * type, selection rings and the recording red.
 *
 * The source owns a local `--rec-accent` custom property that maps to @error.
 * The template drops the custom property and uses @error directly so there is
 * one palette source and no second name to drift. The source's pulse keyframes
 * are omitted: GTK 4.24 ignores transitions/animations and shipping dead frames
 * would be noise, so the dot is static.
 *
 * Selection/recording states stay palette-role literals: a selected mode/segment
 * is a solid @primary fill with @on_primary ink, and the recording lane uses
 * @error with @on_error.
 */
window#capture-window,
window#capture-overlay,
window.capture-cluster-window {
  background-color: transparent;
  color: {{SKIN_INK}};
  font-family: {{SKIN_FONT_FAMILY}};
}

.overlay-root,
.overlay-canvas {
  background-color: transparent;
}

.overlay-dim {
  background-color: alpha(@surface, 0.55);
}

.selrect {
  border: 2px solid @primary;
  background-color: alpha(@primary, 0.1);
  border-radius: 4px;
}

.selhandle,
.hx {
  min-width: 9px;
  min-height: 9px;
  border: 2px solid @surface;
  border-radius: {{SKIN_RADIUS_PILL}};
  background-color: @primary;
}

.selring {
  border: 2px solid @primary;
  background-color: alpha(@primary, 0.06);
  border-radius: 5px;
}

.mon-outline {
  border: 2px solid alpha({{SKIN_INK}}, 0.35);
  border-radius: {{SKIN_RADIUS_CARD}};
  background-color: transparent;
}

.mon-outline.selected {
  border-color: {{SKIN_ACCENT}};
  background-color: alpha({{SKIN_ACCENT}}, 0.08);
}

.overlay-root.recording .selrect {
  border-color: @error;
  background-color: alpha(@error, 0.12);
}

.overlay-root.recording .selhandle,
.overlay-root.recording .hx {
  background-color: @error;
}

.overlay-root.recording .selring {
  border-color: @error;
  background-color: alpha(@error, 0.08);
}

.overlay-root.recording .mon-outline.selected {
  border-color: @error;
  background-color: alpha(@error, 0.09);
}

.overlay-root.recording .selbadge {
  border-color: alpha(@error, 0.55);
  color: @error;
}

.selbadge {
  padding: 3px 9px;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.22);
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: {{SKIN_BG_CARD}};
  color: alpha({{SKIN_INK}}, 0.86);
  font-size: 11px;
  font-weight: 600;
}

.capture-shell {
}

.capture-bar {
  background-color: {{SKIN_BG_PANEL}};
  border: {{SKIN_BORDER_W}} solid {{SKIN_BORDER}};
  border-radius: {{SKIN_RADIUS_PANEL}};
  padding: 6px;
  box-shadow: {{SKIN_SHADOW}};
  backdrop-filter: {{SKIN_BLUR}};
}

.capture-bar.rail {
  min-width: 0;
}

.railicon {
  min-width: 38px;
  min-height: 38px;
  padding: 0;
  border: {{SKIN_HAIRLINE_W}} solid transparent;
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: transparent;
  color: alpha({{SKIN_INK}}, 0.72);
}

.railicon:hover {
  background-color: alpha({{SKIN_INK}}, 0.1);
  color: {{SKIN_INK}};
}

.railicon.active {
  background-color: @primary;
  color: @on_primary;
}

.bar-back {
  min-width: 34px;
  min-height: 34px;
  padding: 0;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  border-radius: {{SKIN_RADIUS_PILL}};
  background-color: transparent;
  color: alpha({{SKIN_INK}}, 0.72);
  font-size: 16px;
  font-weight: 700;
}

.bar-back:hover {
  border-color: alpha({{SKIN_INK}}, 0.22);
  color: {{SKIN_INK}};
}

.bar-group {
  padding: 2px;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.1);
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: alpha(@surface, 0.45);
}

.bar-pill {
  min-height: 30px;
  padding: 0 10px;
  border: {{SKIN_HAIRLINE_W}} solid transparent;
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: transparent;
  color: alpha({{SKIN_INK}}, 0.62);
  font-size: 12px;
  font-weight: 600;
}

.bar-pill:hover {
  color: {{SKIN_INK}};
  background-color: alpha({{SKIN_INK}}, 0.1);
}

.bar-pill.selected {
  background-color: @primary;
  color: @on_primary;
}

.bar-divider {
  min-width: 1px;
  background-color: alpha({{SKIN_INK}}, 0.12);
  margin: 3px 2px;
}

.bar-cta {
  min-height: 36px;
  padding: 0 14px;
  border: none;
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: @primary;
  color: @on_primary;
  font-size: 12px;
  font-weight: 700;
}

.bar-cta.record {
  background-color: @error;
  color: @on_error;
}

.bar-cta.screenshot {
  padding: 0 11px;
}

.capture-shell.recording .railicon.active {
  background-color: @error;
  color: @on_error;
}

.capture-shell.recording .bar-pill.selected {
  background-color: @error;
  color: @on_error;
}

.bar-kbd {
  padding: 1px 4px;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.35);
  border-radius: {{SKIN_RADIUS_CELL}};
  color: alpha({{SKIN_INK}}, 0.82);
  font-size: 10px;
  font-weight: 700;
}

.field {
  background-color: transparent;
}

button.field-trigger {
