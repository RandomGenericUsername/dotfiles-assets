  background-color: alpha({{SKIN_ACCENT}}, 0.12);
  color: {{SKIN_ACCENT}};
  font-size: 11px;
  font-weight: 700;
}

.field-custom-hint {
  padding: 6px 4px 2px;
  font-size: 9.5px;
  color: alpha({{SKIN_INK}}, 0.55);
}

.field-recording.field-open button.field-trigger {
  background-color: alpha(@error, 0.12);
  border-color: alpha(@error, 0.45);
  box-shadow: 0 0 0 1px @error, 0 0 0 3px alpha(@error, 0.2);
}

.field-recording.field-open .field-key,
.field-recording.field-open .field-chevron {
  color: @error;
}

.field-popover-recording row.field-option.field-selected {
  background-color: alpha(@error, 0.12);
}

.field-popover-recording row.field-option.field-selected .field-option-icon {
  color: @error;
}

.field-popover-recording row.field-option.field-selected .field-radio {
  background-color: @error;
  border-color: @error;
}

.field-popover-recording row.field-option.field-selected .field-radio label {
  color: @on_error;
}

.field-popover-recording row.field-option:focus-visible {
  box-shadow: inset 0 0 0 1px @error;
}

.field-popover-recording .field-custom-spin:focus-within {
  border-color: @error;
  box-shadow: 0 0 0 2px alpha(@error, 0.2);
}

.field-popover-recording .field-custom-set {
  border-color: alpha(@error, 0.45);
  background-color: alpha(@error, 0.12);
  color: @error;
}

.inline-field {
  background-color: transparent;
}

.inline-key {
  font-size: 8.5px;
  font-weight: 800;
  letter-spacing: 0.09em;
  color: alpha({{SKIN_INK}}, 0.42);
}

.inline-group {
  padding: 2px;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: alpha({{SKIN_INK}}, 0.04);
}

button.inline-pill {
  min-height: 30px;
  padding: 0 9px;
  border: {{SKIN_HAIRLINE_W}} solid transparent;
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: transparent;
  background-image: none;
  box-shadow: none;
  color: alpha({{SKIN_INK}}, 0.72);
  font-size: 11.5px;
  font-weight: 600;
}

button.inline-pill:hover {
  background-color: alpha({{SKIN_INK}}, 0.06);
  color: {{SKIN_INK}};
}

button.inline-pill:focus-visible {
  box-shadow: inset 0 0 0 1px {{SKIN_ACCENT}};
}

button.inline-pill.selected {
  background-color: @primary;
  color: @on_primary;
}

.capture-shell.recording button.inline-pill:focus-visible {
  box-shadow: inset 0 0 0 1px @error;
}

.capture-shell.recording button.inline-pill.selected {
  background-color: @error;
  color: @on_error;
}

.field-inline-editor {
  padding: 2px 0 2px 4px;
}

.capture-shell.recording .capture-bar.open {
  border-color: alpha(@error, 0.38);
  box-shadow: inset 0 2px 0 @error;
}

.rec-cluster {
  min-width: 109px;
  min-height: 44px;
  background-color: {{SKIN_BG_CARD}};
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  border-radius: {{SKIN_RADIUS_CARD}};
  padding: 4px 8px 4px 10px;
  margin-right: 4px;
}

.rec-cluster.paused {
  border-color: alpha(@tertiary, 0.45);
}

.rec-cluster.full {
  min-width: 161px;
}

.rec-dot {
  min-width: 9px;
  min-height: 9px;
  border-radius: {{SKIN_RADIUS_PILL}};
  background-color: @error;
}

.rec-dot.paused {
  background-color: @tertiary;
  box-shadow: none;
}

.rec-status {
  background-color: transparent;
  background-image: none;
  border: none;
  box-shadow: none;
  padding: 0 2px;
  color: {{SKIN_INK}};
}

.rec-timer {
  padding: 0 6px;
  font-size: 13px;
  font-weight: bold;
  font-variant-numeric: tabular-nums;
  min-width: 46px;
  color: {{SKIN_INK}};
}

.rec-btn {
  min-width: 26px;
  min-height: 26px;
  padding: 0;
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: transparent;
  background-image: none;
  border: none;
  box-shadow: none;
  color: {{SKIN_INK}};
}

.rec-btn:hover,
.rec-btn:active,
.rec-btn:checked,
.rec-btn:focus {
  background-color: alpha({{SKIN_INK}}, 0.1);
  background-image: none;
  border: none;
  box-shadow: none;
}

.rec-btn.stop:hover {
  background-color: alpha(@tertiary, 0.22);
  color: @tertiary;
}

.rec-popup {
  min-width: 216px;
  padding: 14px 16px;
  border-radius: {{SKIN_RADIUS_CARD}};
  background-color: {{SKIN_BG_CARD}};
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
}

.rec-popup.paused {
  border-color: alpha(@tertiary, 0.45);
}

.rec-popup-row {
