}

.mode-switch button {
  min-height: 46px;
  border: {{SKIN_HAIRLINE_W}} solid transparent;
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: transparent;
  color: alpha({{SKIN_INK}}, 0.62);
  font-size: 14px;
  font-weight: 600;
}

.mode-switch button:hover {
