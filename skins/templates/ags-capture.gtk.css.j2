  padding: 4px;
  border: {{SKIN_HAIRLINE_W}} solid transparent;
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: transparent;
  background-image: none;
  box-shadow: none;
  color: {{SKIN_INK}};
}

button.field-trigger:hover {
  background-color: alpha({{SKIN_INK}}, 0.06);
  border-color: alpha({{SKIN_INK}}, 0.12);
}

button.field-trigger:focus-visible {
  background-color: alpha({{SKIN_INK}}, 0.04);
  box-shadow: 0 0 0 1px {{SKIN_ACCENT}}, 0 0 0 3px alpha({{SKIN_ACCENT}}, 0.22);
}

.field-key {
