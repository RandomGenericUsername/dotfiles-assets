}

.settings-item:hover {
  background-color: alpha({{SKIN_INK}}, 0.06);
}

.settings-name {
  font-size: {{SKIN_TEXT_SIZE}};
  font-weight: 600;
  color: {{SKIN_INK}};
}

.settings-desc {
  font-size: 11px;
  color: alpha({{SKIN_INK}}, 0.42);
}

.settings-readout {
  font-size: {{SKIN_TEXT_SIZE}};
  color: {{SKIN_INK_DIM}};
}

.settings-error {
  font-size: 11px;
  color: @error;
}

.path-chip {
  min-height: 30px;
  padding-left: 11px;
  padding-right: 11px;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: alpha(@surface, 0.45);
  font-size: 11px;
  color: alpha({{SKIN_INK}}, 0.62);
}

.path-chip:hover {
  border-color: alpha({{SKIN_INK}}, 0.22);
  color: {{SKIN_INK}};
}

.path-entry {
  min-height: 30px;
  padding-left: 9px;
  padding-right: 9px;
  border: {{SKIN_HAIRLINE_W}} solid alpha(@outline_variant, 0.62);
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: alpha(@surface, 0.45);
  color: {{SKIN_INK}};
  font-size: 11px;
}

.segment.compact {
  min-height: 30px;
  padding-left: 11px;
  padding-right: 11px;
  font-size: 11px;
}

.ghost {
  min-height: 32px;
  padding-left: 13px;
  padding-right: 13px;
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.12);
  border-radius: {{SKIN_RADIUS_CELL}};
  background-color: transparent;
  color: alpha({{SKIN_INK}}, 0.62);
  font-size: 12px;
  font-weight: 600;
}

.ghost:hover {
  border-color: alpha({{SKIN_INK}}, 0.22);
  color: {{SKIN_INK}};
}

switch.palette-switch {
  min-width: 46px;
  min-height: 24px;
  padding: 0;
  border-radius: {{SKIN_RADIUS_PILL}};
  background-color: alpha({{SKIN_INK}}, 0.14);
  border: {{SKIN_HAIRLINE_W}} solid alpha({{SKIN_INK}}, 0.3);
  box-shadow: none;
}

switch.palette-switch:checked {
  background-color: {{SKIN_ACCENT}};
  border-color: {{SKIN_ACCENT}};
}

switch.palette-switch > slider {
  min-width: 16px;
  min-height: 16px;
  margin: 3px;
  border: none;
  border-radius: {{SKIN_RADIUS_PILL}};
  background-color: alpha({{SKIN_INK}}, 0.85);
  box-shadow: 0 1px 2px alpha({{SKIN_INK}}, 0.45);
}

switch.palette-switch:checked > slider {
  background-color: {{SKIN_INK}};
  box-shadow: none;
}
