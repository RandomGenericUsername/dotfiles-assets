/*
 * skins/templates/ags-wallpaper-selector.gtk.css.j2 — wallpaper overlay paint.
 *
 * The wallpaper selector is a layer-shell overlay: `surface.panel` is its
 * outer role (never `surface.window`). The app owns layout, components and
 * content; this sheet declares only role paint/type/ink for the app's declared
 * surfaces plus their state variants.
 *
 * Paint map:
 *   .ws-control-bar, .ws-grid          surface.panel
 *   .ws-settings                       surface.card + panel shadow/blur
 *   .ws-search, .ws-gear, .ws-nav      surface.control
 *   .ws-set, .ws-state-pill, .ws-kbd   surface.pill
 *   .ws-look, .ws-seg-button           surface.control with state fill/ring
 *   .ws-toast                          surface.pill
 *
 * The live dot, the selected-look ring and the commit progress are app-owned
 * content/state; the skin may supply the accent role but never the node.
 */
window#wallpaper-selector-window {
  color: {{SKIN_INK_INK}};
  font-family: {{SKIN_TYPE_FONT_FAMILY}};
}

.ws-control-bar {
  background-color: {{SKIN_SURFACE_PANEL_BG}};
  border: {{SKIN_SURFACE_PANEL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PANEL_BORDER}};
  border-radius: {{SKIN_SURFACE_PANEL_RADIUS}};
  box-shadow: {{SKIN_SURFACE_PANEL_SHADOW}};
  backdrop-filter: {{SKIN_SURFACE_PANEL_BLUR}};
}

.ws-name {
  font-size: {{SKIN_TYPE_SIZE_TITLE}};
  color: {{SKIN_INK_INK}};
}

.ws-meta {
  font-size: {{SKIN_TYPE_SIZE_META}};
  color: {{SKIN_INK_INK_DIM}};
}

.ws-meta.is-step {
  color: {{SKIN_INK_ACCENT}};
}

.ws-meta.is-error {
  color: @error;
}

.ws-state-pill {
  background-color: {{SKIN_SURFACE_PILL_BG}};
  border: {{SKIN_SURFACE_PILL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PILL_BORDER}};
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  font-size: {{SKIN_SURFACE_PILL_FONT_SIZE}};
  letter-spacing: {{SKIN_SURFACE_PILL_LETTER_SPACING}};
}

.ws-state-text {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
}

.ws-kbd {
  background-color: {{SKIN_SURFACE_PILL_BG}};
  border: {{SKIN_SURFACE_PILL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PILL_BORDER}};
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  font-size: {{SKIN_SURFACE_PILL_FONT_SIZE}};
  letter-spacing: {{SKIN_SURFACE_PILL_LETTER_SPACING}};
  color: {{SKIN_INK_INK_DIM}};
}

.ws-look {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
}

.ws-look:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  border-color: {{SKIN_STATE_HOVER_RING}};
}

.ws-look.selected {
  border-color: {{SKIN_INK_ACCENT}};
}

.ws-look:disabled {
  background-color: {{SKIN_STATE_DISABLED_FILL}};
  border-color: {{SKIN_STATE_DISABLED_RING}};
}

.ws-look-name,
.ws-looks-word,
.ws-looks-empty,
.ws-hints {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: {{SKIN_INK_INK_DIM}};
}

.ws-nav {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  color: {{SKIN_INK_INK}};
}

.ws-nav:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.ws-nav:focus-visible {
  outline-color: {{SKIN_STATE_FOCUS_RING}};
}

.ws-gear {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  color: {{SKIN_INK_INK_DIM}};
}

.ws-gear:hover,
.ws-gear:active {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.ws-gear:focus-visible {
  outline-color: {{SKIN_STATE_FOCUS_RING}};
}

.ws-set {
  background-color: {{SKIN_INK_ACCENT}};
  border: {{SKIN_SURFACE_PILL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PILL_BORDER}};
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  font-size: {{SKIN_SURFACE_PILL_FONT_SIZE}};
  font-weight: {{SKIN_TYPE_FONT_WEIGHT}};
  letter-spacing: {{SKIN_SURFACE_PILL_LETTER_SPACING}};
  color: @on_primary;
}

.ws-set.is-live,
.ws-set:disabled {
  background-color: {{SKIN_STATE_DISABLED_FILL}};
  border-color: {{SKIN_STATE_DISABLED_RING}};
  color: {{SKIN_STATE_DISABLED_INK}};
}

.ws-set.is-committing {
  background-color: {{SKIN_STATE_SELECTED_FILL}};
  color: {{SKIN_STATE_SELECTED_INK}};
}

.ws-search {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
  color: {{SKIN_INK_INK}};
}

.ws-grid {
  background-color: {{SKIN_SURFACE_PANEL_BG}};
}

.ws-grid-close {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  color: {{SKIN_INK_INK_DIM}};
}

.ws-grid-close:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.ws-grid-title {
  font-size: {{SKIN_TYPE_SIZE_TITLE}};
  color: {{SKIN_INK_INK}};
}

.ws-grid-count,
.ws-grid-sub,
.ws-grid-meta,
.ws-grid-empty {
  font-size: {{SKIN_TYPE_SIZE_META}};
  color: {{SKIN_INK_INK_DIM}};
}

.ws-grid-name {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: {{SKIN_INK_INK}};
}

.ws-settings {
  background-color: {{SKIN_SURFACE_CARD_BG}};
  border: {{SKIN_SURFACE_CARD_BORDER_WIDTH}} solid {{SKIN_SURFACE_CARD_BORDER}};
  border-radius: {{SKIN_SURFACE_CARD_RADIUS}};
  box-shadow: {{SKIN_SURFACE_PANEL_SHADOW}};
  backdrop-filter: {{SKIN_SURFACE_PANEL_BLUR}};
}

.ws-settings-title {
  font-size: {{SKIN_TYPE_SIZE_TITLE}};
  color: {{SKIN_INK_INK}};
}

.ws-settings-label,
.ws-settings-desc,
.ws-settings-sub,
.ws-settings-foot {
  font-size: {{SKIN_TYPE_SIZE_META}};
  color: {{SKIN_INK_INK_DIM}};
}

.ws-settings-error {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: @error;
}

.ws-seg {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
}

.ws-seg-button {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
  color: {{SKIN_INK_INK_DIM}};
}

.ws-seg-button:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.ws-seg-button.selected {
  background-color: {{SKIN_STATE_SELECTED_FILL}};
  color: {{SKIN_STATE_SELECTED_INK}};
}

.ws-stepper-button {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  color: {{SKIN_INK_INK_DIM}};
}

.ws-stepper-button:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.ws-stepper-value {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: {{SKIN_INK_INK}};
}

.ws-toast {
  background-color: {{SKIN_SURFACE_PILL_BG}};
  border: {{SKIN_SURFACE_PILL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PILL_BORDER}};
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  box-shadow: {{SKIN_SURFACE_PANEL_SHADOW}};
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: {{SKIN_INK_INK}};
}
