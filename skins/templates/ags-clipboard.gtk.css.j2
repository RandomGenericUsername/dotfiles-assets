/*
 * skins/templates/ags-clipboard.gtk.css.j2 — clipboard overlay paint.
 *
 * The clipboard is a layer-shell overlay: `surface.panel` is its outer role
 * (never `surface.window`, never the unused `surface.overlay` experiment). The
 * app owns layout, structure and content; this sheet declares only role
 * paint/type/ink for the app's declared surfaces plus their state variants.
 *
 * Paint map:
 *   .clipboard-full / .clipboard-compact / .clipboard-control-bar
 *   .clipboard-pins-panel / .clipboard-panel       surface.panel
 *   .clipboard-card / .clipboard-stage-card
 *   .clipboard-peek-card / .clipboard-pin-card     surface.card
 *   .clipboard-pin-body / stage / peek bodies       surface.card
 *   .clipboard-search-box / .clipboard-chip
 *   .clipboard-pins-pill / .clipboard-nav-arrow
 *   .clipboard-strip-arrow / .clipboard-keycap      surface.pill
 *   .clipboard-gear / .clipboard-bar-button
 *   .clipboard-open-chip / .clipboard-view-tab      surface.control
 *   .clipboard-settings                             surface.card + panel shadow
 *
 * Type headers, type/filter dots, per-kind selected/focused rings and pin fills
 * are app-owned content painted by per-widget providers at USER + 1. They do
 * not appear in this template. Selected states replace the base role border;
 * the skin supplies only the base role border.
 *
 * `[host]` geometry follows surface.panel/card/control/cell radii, so
 * terminal-host tracks the compositor's rounding and border size.
 */
window#clipboard-window {
  background-color: transparent;
  color: {{SKIN_INK_INK}};
  font-family: {{SKIN_TYPE_FONT_FAMILY}};
}

.clipboard-root {
  background-color: transparent;
  color: {{SKIN_INK_INK}};
}

/* Outer overlay surfaces: surface.panel, never surface.window/overlay. */
.clipboard-panel,
.clipboard-full,
.clipboard-compact,
.clipboard-control-bar,
.clipboard-pins-panel {
  background-color: {{SKIN_SURFACE_PANEL_BG}};
  border: {{SKIN_SURFACE_PANEL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PANEL_BORDER}};
  border-radius: {{SKIN_SURFACE_PANEL_RADIUS}};
  box-shadow: {{SKIN_SURFACE_PANEL_SHADOW}};
  backdrop-filter: {{SKIN_SURFACE_PANEL_BLUR}};
  color: {{SKIN_INK_INK}};
}

/* Cards and their bodies take surface.card paint/geometry. */
.clipboard-card,
.clipboard-stage-card,
.clipboard-peek-card,
.clipboard-pin-card {
  background-color: {{SKIN_SURFACE_CARD_BG}};
  border: {{SKIN_SURFACE_CARD_BORDER_WIDTH}} solid {{SKIN_SURFACE_CARD_BORDER}};
  border-radius: {{SKIN_SURFACE_CARD_RADIUS}};
  color: {{SKIN_INK_INK}};
}

.clipboard-card:hover,
.clipboard-stage-card:hover,
.clipboard-peek-card:hover,
.clipboard-pin-card:hover {
  border-color: {{SKIN_STATE_HOVER_RING}};
}

.clipboard-stage-body,
.clipboard-peek-body,
.clipboard-pin-body {
  background-color: {{SKIN_SURFACE_CARD_BG}};
  border-radius: {{SKIN_SURFACE_CARD_RADIUS}};
  color: {{SKIN_INK_INK}};
}

/* Search: the pill owns the box; the inner entry must not draw its own ring. */
.clipboard-search-box {
  background-color: {{SKIN_SURFACE_PILL_BG}};
  border: {{SKIN_SURFACE_PILL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PILL_BORDER}};
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  color: {{SKIN_INK_INK}};
}

.clipboard-search-box.focused {
  border-color: {{SKIN_STATE_FOCUS_RING}};
  box-shadow: 0 0 0 1px {{SKIN_STATE_FOCUS_RING}};
}

.clipboard-search {
  background-color: transparent;
  border: none;
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  color: {{SKIN_INK_INK}};
}

.clipboard-search:focus,
.clipboard-search:focus-within,
.clipboard-search:focus-visible {
  outline: none;
  box-shadow: none;
  border: none;
}

/* Pills: chips, view tabs, pills, arrows and keycaps. */
.clipboard-chip,
.clipboard-pins-pill,
.clipboard-nav-arrow,
.clipboard-strip-arrow,
.clipboard-keycap {
  background-color: {{SKIN_SURFACE_PILL_BG}};
  border: {{SKIN_SURFACE_PILL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PILL_BORDER}};
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  color: {{SKIN_INK_INK}};
}

.clipboard-chip:hover,
.clipboard-pins-pill:hover,
.clipboard-nav-arrow:hover,
.clipboard-strip-arrow:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  border-color: {{SKIN_STATE_HOVER_RING}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.clipboard-chip.selected {
  background-color: {{SKIN_STATE_SELECTED_FILL}};
  border-color: {{SKIN_STATE_FOCUS_RING}};
  color: {{SKIN_STATE_SELECTED_INK}};
}

.clipboard-keycap {
  font-size: {{SKIN_TYPE_SIZE_CAPTION}};
  color: {{SKIN_INK_INK_DIM}};
}

/* Controls: gear, bar buttons, open chip, view tabs and segments. */
.clipboard-gear,
.clipboard-bar-button,
.clipboard-open-chip,
.clipboard-view-tab,
.clipboard-segment-button,
.clipboard-incognito,
.clipboard-clear {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  color: {{SKIN_INK_INK}};
}

.clipboard-gear:hover,
.clipboard-bar-button:hover,
.clipboard-open-chip:hover,
.clipboard-view-tab:hover,
.clipboard-segment-button:hover,
.clipboard-incognito:hover,
.clipboard-clear:hover {
  background-color: {{SKIN_STATE_HOVER_FILL}};
  border-color: {{SKIN_STATE_HOVER_RING}};
  color: {{SKIN_STATE_HOVER_INK}};
}

.clipboard-gear:focus-visible,
.clipboard-bar-button:focus-visible,
.clipboard-open-chip:focus-visible,
.clipboard-view-tab:focus-visible,
.clipboard-segment-button:focus-visible {
  outline-color: {{SKIN_STATE_FOCUS_RING}};
}

.clipboard-view-tab.active,
.clipboard-bar-button.is-on,
.clipboard-segment-button.selected {
  background-color: {{SKIN_STATE_SELECTED_FILL}};
  border-color: {{SKIN_STATE_FOCUS_RING}};
  color: {{SKIN_STATE_SELECTED_INK}};
}

/* In-page settings panel over a transparent catcher; no popover nodes. */
.clipboard-settings {
  background-color: {{SKIN_SURFACE_CARD_BG}};
  border: {{SKIN_SURFACE_CARD_BORDER_WIDTH}} solid {{SKIN_SURFACE_CARD_BORDER}};
  border-radius: {{SKIN_SURFACE_CARD_RADIUS}};
  box-shadow: {{SKIN_SURFACE_PANEL_SHADOW}};
  backdrop-filter: {{SKIN_SURFACE_PANEL_BLUR}};
  color: {{SKIN_INK_INK}};
}

.clipboard-settings-catcher {
  background-color: transparent;
}

.clipboard-empty {
  color: {{SKIN_INK_INK_DIM}};
}
