{
  "$comment": "The skins contract's LOCAL validation target. Token value types are NOT defined here: every token property delegates by external $ref to the vendored canonical pair under skins/contracts/ (see canonical.delegates and skins/contracts/PIN). The canonical schemas type radii/border-w/gap/title-size/text-size/layout tokens as unitless JSON numbers and cell-pad as a literal \"Npx Npx\" string; a numeric string such as \"12px\" is rejected. This file adds only the frozen local manifest envelope (schema_major + six flat groups) and the palette/forbidden metadata. Re-vendoring must update the PIN hashes and canonical.tag together; schema_major moves independently of the repo tag.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skins/schema.json",
  "title": "dotfiles-assets skin manifest v1",
  "schema_major": 1,
  "contract": "skins",
  "status": "populated (v0.9.0)",
  "canonical": {
    "repository": "contracts",
    "paths": [
      "schemas/skin-token.schema.json",
      "schemas/skin-manifest.schema.json"
    ],
    "tag": "v0.5.1",
    "vendored": true,
    "pin": "skins/contracts/PIN",
    "vendored_paths": [
      "skins/contracts/skin-token.schema.json",
      "skins/contracts/skin-manifest.schema.json"
    ],
    "delegates": {
      "token": "skins/contracts/skin-token.schema.json",
      "manifest": "skins/contracts/skin-manifest.schema.json"
    },
    "note": "Byte-for-byte copies of the canonical pair are vendored under skins/contracts/ and pinned by sha256 in skins/contracts/PIN. The pinned tag is v0.5.1, the unit-convention patch: numeric tokens are unitless JSON numbers (the CSS expander adds px) and cell-pad is the only literal length-pair string. Token value types are external $refs to the vendored manifest schema, never a local lookalike grammar."
  },
  "palette": {
    "vocabulary": "palette.v1",
    "role_count": 51,
    "source": "icons/mappings/vocabulary.json (the declared role vocabulary of record in this repository; 50 theme-producer Material roles + on_backdrop, REQ-022)",
    "note": "A surface/ink expression may name only one of these roles. Producer aliases (foreground, accent, accent-muted, warning) and colorN carrier indices are not roles; the validator rejects them.",
    "roles": [
      "background",
      "error",
      "error_container",
      "inverse_on_surface",
      "inverse_primary",
      "inverse_surface",
      "on_background",
      "on_error",
      "on_error_container",
      "on_primary",
      "on_primary_container",
      "on_primary_fixed",
      "on_primary_fixed_variant",
      "on_secondary",
      "on_secondary_container",
      "on_secondary_fixed",
      "on_secondary_fixed_variant",
      "on_surface",
      "on_surface_variant",
      "on_tertiary",
      "on_tertiary_container",
      "on_tertiary_fixed",
      "on_tertiary_fixed_variant",
      "outline",
      "outline_variant",
      "primary",
      "primary_container",
      "primary_fixed",
      "primary_fixed_dim",
      "scrim",
      "secondary",
      "secondary_container",
      "secondary_fixed",
      "secondary_fixed_dim",
      "shadow",
      "source_color",
      "surface",
      "surface_bright",
      "surface_container",
      "surface_container_high",
      "surface_container_highest",
      "surface_container_low",
      "surface_container_lowest",
      "surface_dim",
      "surface_tint",
      "surface_variant",
      "tertiary",
      "tertiary_container",
      "tertiary_fixed",
      "tertiary_fixed_dim",
      "on_backdrop"
    ]
  },
  "frozen": {
    "manifest_format": "toml",
    "required_files": [
      "glass",
      "flat",
      "paper"
    ],
    "token_groups": {
      "shape": [
        "radius-panel",
        "radius-card",
        "radius-cell",
        "radius-pill",
        "border-w"
      ],
      "rhythm": [
        "gap",
        "cell-pad"
      ],
      "surface": [
        "bg-panel",
        "bg-card",
        "border",
        "shadow",
        "blur"
      ],
      "ink": [
        "ink",
        "ink-dim",
        "accent",
        "ink-over"
      ],
      "type": [
        "font-family",
        "title-size",
        "text-size"
      ],
      "layout": [
        "panel-width",
        "bt-list-spacing",
        "bar-row-height",
        "chip-min"
      ]
    },
    "forbidden_keys": [
      "structure",
      "variant",
      "variants",
      "state",
      "transition",
      "animation",
      "density",
      "paint"
    ],
    "forbidden_patterns": [
      "#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})\\b",
      "\\btransition\\s*:",
      "\\banimation\\s*:"
    ],
    "notes": [
      "A skin is palette/ink mapping + paint + rhythm/density. Structure (which widget sits where) and variant names belong to the app.",
      "Surface, border and shadow values are palette-role expressions or transparent; a literal hex colour is never a skin value.",
      "GTK 4.24 ignores transitions, so the format forbids them rather than shipping dead declarations.",
      "blur is `none` or `blur(Npx)` with an optional `saturate(N)`; backdrop-filter blur is proven to paint in GTK 4.24."
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_major",
    "name",
    "shape",
    "rhythm",
    "surface",
    "ink",
    "type",
    "layout"
  ],
  "properties": {
    "schema_major": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radius-panel",
        "radius-card",
        "radius-cell",
        "radius-pill",
        "border-w"
      ],
      "properties": {
        "radius-panel": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/nonNegativeNumber"
        },
        "radius-card": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/nonNegativeNumber"
        },
        "radius-cell": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/nonNegativeNumber"
        },
        "radius-pill": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/nonNegativeNumber"
        },
        "border-w": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/number"
        }
      }
    },
    "rhythm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap",
        "cell-pad"
      ],
      "properties": {
        "gap": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/number"
        },
        "cell-pad": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/cellPad"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bg-panel",
        "bg-card",
        "border",
        "shadow",
        "blur"
      ],
      "properties": {
        "bg-panel": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/paint"
        },
        "bg-card": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/paint"
        },
        "border": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/paint"
        },
        "shadow": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/paint"
        },
        "blur": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/blurValue"
        }
      }
    },
    "ink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "ink-dim",
        "accent",
        "ink-over"
      ],
      "properties": {
        "ink": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/inkValue"
        },
        "ink-dim": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/inkValue"
        },
        "accent": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/inkValue"
        },
        "ink-over": {
          "$ref": "contracts/skin-manifest.schema.json#/properties/groups/properties/ink/properties/ink-over"
        }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font-family",
        "title-size",
        "text-size"
      ],
      "properties": {
        "font-family": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/fontFamily"
        },
        "title-size": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/number"
        },
        "text-size": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/number"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel-width",
        "bt-list-spacing",
        "bar-row-height",
        "chip-min"
      ],
      "properties": {
        "panel-width": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/number"
        },
        "bt-list-spacing": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/number"
        },
        "bar-row-height": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/number"
        },
        "chip-min": {
          "$ref": "contracts/skin-manifest.schema.json#/definitions/number"
        }
      }
    }
  }
}
